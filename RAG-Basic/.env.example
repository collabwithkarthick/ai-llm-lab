# Copy this file to .env and set your LLM API key there.
# Never commit or share the real key.
LLM_API_KEY=

# Optional model overrides; these are the service defaults.
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

# PDFs in this folder (including subfolders) are used as the knowledge source.
RAG_DOCUMENT_DIR=rag_service/files

# Set RAG_DOCUMENT_DIR= to use a direct HTTPS URL for UTF-8 text instead.
RAG_DOCUMENT_URL=
