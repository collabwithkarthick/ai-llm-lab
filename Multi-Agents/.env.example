# Qdrant HTTP endpoint. The default matches the RAG-Layered local service.
QDRANT_URL=http://127.0.0.1:6333

# RAG-Layered LiteLLM gateway. LLM_API_KEY must match LLM_API_KEY in
# RAG-Layered/.env; GEMINI_API_KEY stays in RAG-Layered/.env.
LLM_GATEWAY_URL=http://127.0.0.1:4000
LLM_MODEL=helpdesk-llm
LLM_API_KEY=replace_with_the_same_gateway_key_used_by_RAG-Layered
