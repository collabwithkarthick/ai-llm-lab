# Qdrant connection settings
# This project is currently running the services on the Windows host,
# so Flask and the gateway should use localhost rather than a WSL IP.
QDRANT_URL=http://127.0.0.1:6333
#QDRANT_HOST=localhost
#QDRANT_PORT=6333

# LiteLLM gateway settings for the chat app
LLM_GATEWAY_URL=http://127.0.0.1:4000
LLM_MODEL=helpdesk-llm
OLLAMA_API_BASE=http://192.168.1.32:11434

# Compatibility: keep both names available for older config and current Gemini fallback.
LLM_API_KEY=
GEMINI_API_KEY=
